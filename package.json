		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"fast-check": "^4.10.2",
		"happy-dom": "^21.0.4",
		"tailwindcss": "^4.3.3",
