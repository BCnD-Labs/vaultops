		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"lodash": "^4.17.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
