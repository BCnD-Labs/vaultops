{
	"name": "vaultops",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run test",
		"mac-check": "bash scripts/mac-check.sh",
		"open": "bash scripts/open-vaultops.sh",
		"install-app": "bash scripts/install-vaultops.sh"
	},
	"devDependencies": {
