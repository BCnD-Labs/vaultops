{
	"name": "vaultops",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run test",
		"mac-check": "bash scripts/mac-check.sh",
		"open": "bash scripts/open-vaultops.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.5.0",
		"@tauri-apps/api": "^2.12.4",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-list": "^3.32.0",
		"@tiptap/extension-unique-id": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/react": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@tiptap/suggestion": "^3.32.0",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.66.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0"
	}
}
